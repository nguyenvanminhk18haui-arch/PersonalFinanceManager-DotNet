<Window x:Class="ThuChiCaNhan.CategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Danh mục giao dịch" Width="430" Height="540" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}" ShowInTaskbar="False" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Danh mục" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Các nhóm dùng để sắp xếp những khoản thu chi." Foreground="#738296" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>
        <ListBox x:Name="CategoriesList" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="11" Padding="14,12" Margin="0,0,0,8" BorderBrush="#E4EBEF" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#E8F4F1" CornerRadius="8" Padding="9,4" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Type}" Foreground="#167A68" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="2" Content="Đóng" Background="#168A72" Foreground="White" HorizontalAlignment="Right" MinWidth="90" Margin="0,14,0,0" IsDefault="True" Click="Close_Click" />
    </Grid>
</Window>
