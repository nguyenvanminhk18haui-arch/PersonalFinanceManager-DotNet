<Window x:Class="ThuChiCaNhan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Sổ Nhỏ — Quản lý thu chi" Height="900" Width="1440"
        MinHeight="720" MinWidth="1080" WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BorderBrush" Value="#E7EDF0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#18364A" Opacity="0.045" BlurRadius="18" ShadowDepth="3" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#75839A" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SidebarItem" TargetType="Button">
            <Setter Property="Foreground" Value="#E3EDF2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="MenuContent"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#28647A" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="MenuContent" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#28647A" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="MenuContent" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#142D42">
            <Grid Margin="22,27,18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,42">
                    <Border Width="38" Height="38" CornerRadius="13" Background="#168A72" VerticalAlignment="Center">
                        <TextBlock Text="S" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="sổ nhỏ" Foreground="White" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="TÀI CHÍNH CÁ NHÂN" Foreground="#8FA5B8" FontSize="9" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="KHÔNG GIAN CỦA BẠN" Foreground="#7790A5" FontSize="10" FontWeight="Bold" Margin="2,0,0,12" />
                    <Button Style="{StaticResource SidebarItem}" Background="#168A72" Foreground="White" FontWeight="SemiBold" Click="OverviewNav_Click">
                        <TextBlock Text="◫   Tổng quan" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource SidebarItem}" Click="BudgetsNav_Click">
                        <TextBlock Text="◈   Ngân sách" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource SidebarItem}" Click="WalletsNav_Click">
                        <TextBlock Text="▣   Ví tiền" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource SidebarItem}" Click="RecurringNav_Click">
                        <TextBlock Text="↻   Định kỳ" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource SidebarItem}" Click="ReportsNav_Click">
                        <TextBlock Text="▤   Báo cáo tháng" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
                <Border Grid.Row="3" Background="#1C3B50" CornerRadius="14" Padding="15">
                    <StackPanel>
                        <TextBlock Text="MỘT THÓI QUEN NHỎ" Foreground="#81D2BC" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="Ghi lại hôm nay, hiểu rõ ngày mai." Foreground="#D8E4EC" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="38,30,38,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tổng quan tài chính" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="Một góc nhìn rõ ràng hơn về dòng tiền của bạn." Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                </StackPanel>
                <ComboBox x:Name="MonthSelector" Grid.Column="1" Width="164" Height="40" Margin="0,0,10,0"
                          ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedMonth}"
                          SelectionChanged="MonthSelector_SelectionChanged" VerticalContentAlignment="Center" />
                <Button Grid.Column="2" Content="＋  Thêm giao dịch" Background="#168A72" Foreground="White"
                        Click="AddTransaction_Click" Padding="17,12" />
            </Grid>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="THU NHẬP" FontSize="10" FontWeight="Bold" Foreground="#738296" />
                            <TextBlock Text="  ↗" Foreground="#168A72" FontSize="13" />
                        </StackPanel>
                        <TextBlock Text="{Binding Income, StringFormat={}{0:N0} ₫}" FontSize="27" FontWeight="Bold" Margin="0,10,0,4" />
                        <TextBlock Text="Tổng tiền vào trong tháng" Style="{StaticResource MutedLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CHI TIÊU" FontSize="10" FontWeight="Bold" Foreground="#738296" />
                            <TextBlock Text="  ↘" Foreground="#D47B62" FontSize="13" />
                        </StackPanel>
                        <TextBlock Text="{Binding Expense, StringFormat={}{0:N0} ₫}" FontSize="27" FontWeight="Bold" Margin="0,10,0,4" />
                        <TextBlock Text="Tổng tiền ra trong tháng" Style="{StaticResource MutedLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SỐ DƯ" FontSize="10" FontWeight="Bold" Foreground="#738296" />
                            <TextBlock Text="  ◇" Foreground="#6679C7" FontSize="13" />
                        </StackPanel>
                        <TextBlock Text="{Binding Balance, StringFormat={}{0:N0} ₫}" FontSize="27" FontWeight="Bold" Margin="0,10,0,4" />
                        <TextBlock Text="Thu nhập trừ đi chi tiêu" Style="{StaticResource MutedLabel}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.82*" />
                    <ColumnDefinition Width="1.48*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Chi tiêu theo danh mục" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="Tháng này tiền đi đâu?" Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,14,0,8">
                            <lvc:PieChart Series="{Binding ExpenseSeries}" LegendPosition="Bottom" InitialRotation="-90" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,0,28">
                                <TextBlock Text="CHI TIÊU" FontSize="9" FontWeight="Bold" Foreground="#75839A" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Expense, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="đồng" FontSize="10" Foreground="#75839A" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="Tỷ trọng được tính từ các khoản chi đã ghi." Style="{StaticResource MutedLabel}" FontSize="10" TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0" Padding="23,21,23,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Giao dịch gần đây" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="Những khoản thu chi trong tháng đã chọn." Style="{StaticResource MutedLabel}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Content="Xuất Excel" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#E9F5F1" Foreground="#167A68" Padding="13,9" Click="Export_Click" />
                        </Grid>
                        <DataGrid x:Name="TransactionsGrid" Grid.Row="1" ItemsSource="{Binding Transactions}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                  RowHeight="52" BorderThickness="0" Background="White" SelectionMode="Single"
                                  AlternationCount="2" AlternatingRowBackground="#FAFBFD">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F4F7FA" />
                                    <Setter Property="Foreground" Value="#75839A" />
                                    <Setter Property="FontSize" Value="10" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Padding" Value="9,11" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NGÀY" Binding="{Binding Date, StringFormat=dd MMM}" Width="78" />
                                <DataGridTextColumn Header="DANH MỤC" Binding="{Binding Category.Name}" Width="120" />
                                <DataGridTextColumn Header="VÍ" Binding="{Binding Wallet.Name}" Width="110" />
                                <DataGridTextColumn Header="GHI CHÚ" Binding="{Binding Note}" Width="*" />
                                <DataGridTextColumn Header="LOẠI" Binding="{Binding Type}" Width="88" />
                                <DataGridTextColumn Header="SỐ TIỀN" Binding="{Binding Amount, StringFormat={}{0:N0} ₫}" Width="120" />
                                <DataGridTemplateColumn Header="" Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×" Tag="{Binding Id}" Click="DeleteTransaction_Click"
                                                    Background="Transparent" Foreground="#A0AABA" Padding="7,3"
                                                    ToolTip="Xóa giao dịch" FontSize="17" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="1,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" FontSize="11" />
                <TextBlock Grid.Row="1" Text="{Binding BudgetAlert}" Foreground="#B43D36" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="DỮ LIỆU CỦA BẠN · LƯU TRÊN SQL SERVER" HorizontalAlignment="Right" Foreground="#93A0B1" FontSize="9" FontWeight="SemiBold" />
            </Grid>
        </Grid>
    </Grid>
</Window>
