<Window x:Class="ThuChiCaNhan.BudgetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ngân sách tháng" Width="760" Height="610" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}" ShowInTaskbar="False" Loaded="Window_Loaded" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Ngân sách theo danh mục" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Cảnh báo xuất hiện khi mức chi đạt 80% hạn mức hoặc vượt quá." Foreground="#738296" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>
            <ComboBox x:Name="MonthSelector" Width="170" Height="38" HorizontalAlignment="Right" VerticalAlignment="Center"
                      ItemsSource="{Binding MonthOptions}" SelectionChanged="MonthSelector_SelectionChanged" />
        </Grid>
        <DataGrid x:Name="BudgetsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="40"
                  SelectionChanged="BudgetsGrid_SelectionChanged" Background="White" BorderBrush="#E4EBEF" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DANH MỤC" Binding="{Binding Category.Name}" Width="*" />
                <DataGridTextColumn Header="ĐÃ CHI" Binding="{Binding Spent, StringFormat={}{0:N0} ₫}" Width="145" />
                <DataGridTextColumn Header="HẠN MỨC" Binding="{Binding Limit, StringFormat={}{0:N0} ₫}" Width="145" />
                <DataGridTextColumn Header="CÒN LẠI" Binding="{Binding Remaining, StringFormat={}{0:N0} ₫}" Width="145" />
                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="115" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="155" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CategorySelector" Height="40" Margin="0,0,10,0" DisplayMemberPath="Name" VerticalContentAlignment="Center" />
            <TextBox x:Name="LimitInput" Grid.Column="1" Height="40" Padding="10,8" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="Hạn mức VND" />
            <TextBlock Grid.Column="2" Text="Hạn mức (VND)" Foreground="#75839A" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Grid.Column="3" Content="Lưu hạn mức" Background="#168F78" Foreground="White" Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
